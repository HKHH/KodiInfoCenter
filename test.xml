<?xml version='1.0' encoding='utf-8'?>
<addon id="plugin.script.meinSkript" name="KODI Infocenter" version="1.0.0" provider-name="Holger Klemm">
    <requires>
        
        <import addon="xbmc.python" version="3.0.0" />
    </requires>
    
    <extension point="xbmc.python.script" library="kodiinfocenter.py" />
    <extension point="xbmc.addon.metadata">
        <summary lang="de">KODI Informationen für 5" Display</summary>
        <description lang="de">
            Dieses Service startet automatisch beim Start von Kodi ein 800x480 großes Fenster mit Information zum Kodi Status.
        </description>
        <platform>all</platform>
    </extension>
</addon>